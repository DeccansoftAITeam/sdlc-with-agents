{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "typecheck": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    }
  },
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "tui": {
    "enabled": false
  }
}
